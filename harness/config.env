# Non-secret defaults for the llm-d/MaaS harness. This harness assumes the
# base cluster (OpenShift, GPU nodes, RHOAI) already exists. It adds the
# llm-d-specific pieces on top: prerequisites check (llmd-prereq), MaaS/RHCL,
# tracing, model deployment, and scenarios 11-14 / 21-29. See ../AGENT.md.
#
# Override any of these by exporting the same name before invoking
# harness.sh, e.g.: HARNESS_PROFILE=sno ./harness.sh sno-check

# Cluster profile: aws (default; multi-node AWS cluster built by openshift-aws-harness)
# | sno (scenarios-2 on the RHDP sandbox1343 cluster: SNO control plane, local oc session).
# Profile files set exec mode, bastion, GPU instance type and the demo model manifest:
# harness/profiles/<name>.env.
HARNESS_PROFILE="${HARNESS_PROFILE:-aws}"
[ -f "./profiles/${HARNESS_PROFILE}.env" ] || { echo "unknown HARNESS_PROFILE=$HARNESS_PROFILE (harness/profiles/*.env)" >&2; exit 1; }
source "./profiles/${HARNESS_PROFILE}.env"

# Where remote/*.sh run: local | bastion | auto (local if `oc whoami` works).
HARNESS_EXEC="${HARNESS_EXEC:-auto}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/${CLUSTER_NAME}-bastion}"

# Model/resource defaults kept from the T4 (g4dn.xlarge) measurements so results
# stay comparable; they fit one A10G or L4 (24GB) as well. Larger model on A10G 24GB:
#   LLMD_MODEL_URI=hf://Qwen/Qwen2.5-7B-Instruct LLMD_MEMORY=16Gi LLMD_MAX_MODEL_LEN=16384 LLMD_GPU_MEM_UTIL=0.90
LLMD_MODEL_URI="${LLMD_MODEL_URI:-hf://Qwen/Qwen2.5-1.5B-Instruct}"
LLMD_MEMORY="${LLMD_MEMORY:-8Gi}"
LLMD_MAX_MODEL_LEN="${LLMD_MAX_MODEL_LEN:-8192}"
LLMD_GPU_MEM_UTIL="${LLMD_GPU_MEM_UTIL:-0.85}"

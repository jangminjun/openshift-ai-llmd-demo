{
  "title": "llm-d Observability (TTFT / Throughput / Error Rate)",
  "uid": "llmd-observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "TTFT (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kserve_vllm:time_to_first_token_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))",
          "legendFormat": "TTFT p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kserve_http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "Total requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "axisSoftMax": 0.05
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kserve_http_requests_total{namespace=\"$namespace\",status=~\"4xx|5xx\"}[5m])) / sum(rate(kserve_http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "KV Cache Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(kserve_vllm:kv_cache_usage_perc{namespace=\"$namespace\"}, \"short\", \"$1\", \"pod\", \".*-([a-z0-9]+)$\")",
          "legendFormat": "KV cache used - pod {{short}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency breakdown per request (mean)",
      "description": "Mean seconds per request spent waiting for a slot (queue), processing the prompt (prefill) and generating tokens (decode). The tallest band is the bottleneck.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "queue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prefill"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(kserve_vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "queue time (mean)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kserve_vllm:request_prefill_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_prefill_time_seconds_count{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "prefill time (mean)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(kserve_vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "decode time (mean)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Share of request time",
      "description": "Each stage's mean divided by queue+prefill+decode: which stage dominates each request (legend = true shares).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "queue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prefill"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(kserve_vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[1m]))) / ((sum(rate(kserve_vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_prefill_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_prefill_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[1m]))))",
          "legendFormat": "queue share",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(kserve_vllm:request_prefill_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_prefill_time_seconds_count{namespace=\"$namespace\"}[1m]))) / ((sum(rate(kserve_vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_prefill_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_prefill_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[1m]))))",
          "legendFormat": "prefill share",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(kserve_vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[1m]))) / ((sum(rate(kserve_vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_prefill_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_prefill_time_seconds_count{namespace=\"$namespace\"}[1m]))) + (sum(rate(kserve_vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[1m])) / sum(rate(kserve_vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[1m]))))",
          "legendFormat": "decode share",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "Requests waiting / running",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vLLM waiting requests"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vLLM running requests"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(kserve_vllm:num_requests_waiting{namespace=\"$namespace\"})",
          "legendFormat": "vLLM waiting requests",
          "refId": "A"
        },
        {
          "expr": "sum(kserve_vllm:num_requests_running{namespace=\"$namespace\"})",
          "legendFormat": "vLLM running requests",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Flow Control / Priority (scenario 21)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "TTFT p95 by priority (EPP)",
      "description": "EPP-measured TTFT per InferenceObjective priority. Inversion: p100 at or above p0.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 100$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 0$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, priority)(rate(llm_d_epp_request_ttft_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "TTFT p95 - priority {{priority}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "EPP queue wait by priority (mean)",
      "description": "Time spent in the EPP Flow Control queue. Flow Control must be enabled. Inversion: p100 wait > p0 wait.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 100$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 0$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (priority)(rate(llm_d_epp_flow_control_request_queue_duration_seconds_sum{namespace=\"$namespace\"}[1m])) / sum by (priority)(rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "EPP queue wait - priority {{priority}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Where requests wait: EPP priority queue vs vLLM FCFS queue",
      "description": "Priority only applies while requests wait in the EPP queue. A queue building inside vLLM (utilization-detector) is FCFS and causes priority inversion.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 100$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 0$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^vLLM.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (priority)(llm_d_epp_flow_control_queue_size{namespace=\"$namespace\"})",
          "legendFormat": "EPP queue length - priority {{priority}}",
          "refId": "A"
        },
        {
          "expr": "sum(kserve_vllm:num_requests_waiting{namespace=\"$namespace\"})",
          "legendFormat": "vLLM waiting (FCFS, all priorities)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "Dispatched req/s by priority and pool saturation",
      "description": "Request throughput per priority; saturation (right axis) is the detector output (>=1 means saturated).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 100$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*priority 0$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pool saturation"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (priority)(rate(llm_d_epp_request_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "req/s - priority {{priority}}",
          "refId": "A"
        },
        {
          "expr": "max(llm_d_epp_flow_control_pool_saturation{namespace=\"$namespace\"})",
          "legendFormat": "pool saturation",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Routing / Scorer (scenario 22)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "panels": []
    },
    {
      "id": 14,
      "title": "Requests/s by pod",
      "description": "How EPP splits requests across vLLM pods. no-hit-lru / kv-cache-utilization scorers change this split.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(sum by (pod)(rate(kserve_vllm:request_success_total{namespace=\"$namespace\"}[1m])), \"short\", \"$1\", \"pod\", \".*-([a-z0-9]+)$\")",
          "legendFormat": "req/s - pod {{short}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Prefix cache hit rate by pod",
      "description": "Share of prompt tokens served from the prefix cache. prefix-cache-scorer raises this by routing a document back to the pod that cached it.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(sum by (pod)(rate(kserve_vllm:prefix_cache_hits_total{namespace=\"$namespace\"}[1m])) / sum by (pod)(rate(kserve_vllm:prefix_cache_queries_total{namespace=\"$namespace\"}[1m])), \"short\", \"$1\", \"pod\", \".*-([a-z0-9]+)$\")",
          "legendFormat": "prefix cache hit rate - pod {{short}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "KV cache usage by pod",
      "description": "KV cache in use per pod. kv-cache-utilization-scorer steers new requests away from the fuller pod.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(max by (pod)(kserve_vllm:kv_cache_usage_perc{namespace=\"$namespace\"}), \"short\", \"$1\", \"pod\", \".*-([a-z0-9]+)$\")",
          "legendFormat": "KV cache used - pod {{short}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "TTFT p50 / p95",
      "description": "End effect of routing: cache hits shorten prefill and therefore TTFT.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_THANOS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le)(rate(kserve_vllm:time_to_first_token_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "TTFT p50 - all pods",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(kserve_vllm:time_to_first_token_seconds_bucket{namespace=\"$namespace\"}[1m])))",
          "legendFormat": "TTFT p95 - all pods",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "${DS_THANOS}",
        "query": "label_values(kserve_vllm:request_success_total, namespace)",
        "refresh": 2,
        "includeAll": false
      }
    ]
  }
}

# Profile "sno": scenarios-2 on the RHDP sandbox1343 cluster -- Single Node OpenShift
# control plane (g6.8xlarge, L4 x 1) plus GPU worker MachineSets. No bastion: remote/*.sh
# run against the local `oc login` session. Selected with HARNESS_PROFILE=sno.
HARNESS_EXEC="${HARNESS_EXEC:-local}"
CLUSTER_NAME="${CLUSTER_NAME:-sno}"
BASTION_IP="${BASTION_IP:-}"
# Empty = the instance type of the first nvidia.com/gpu.present=true node.
GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-}"
# replicas 1, no nodeSelector (only one node exists).
LLMD_MANIFEST="${LLMD_MANIFEST:-../manifests/sno/llmd-test-llminferenceservice.json}"

# sno-enable-features: third-party RHOAI 3.5 "enable all features" script for
# SNO (DSC components, dashboard flags, MLflow, EvalHub, MaaS Gateway, RHCL,
# Service Mesh, Dev Spaces). Pinned to a commit; cached in harness/.cache/.
SNO_FEATURES_SCRIPT_URL="${SNO_FEATURES_SCRIPT_URL:-https://raw.githubusercontent.com/jingggg-wenn/rhoai-sno-setup-guide/d7ca97cc4f6181ad9df0579d46c35271a73fdacf/scripts/sno-enable-all-features-35.sh}"
SNO_FEATURES_ARGS="${SNO_FEATURES_ARGS:-}"   # e.g. --skip-install

# Pod-template changes (tracing, vLLM args) on a 1-GPU node: scale to 0 and back instead
# of a maxSurge rollout that would stay Pending (remote/lib/bench.sh rollout_begin).
GPU_ROLLOUT="${GPU_ROLLOUT:-recreate}"

# Profile "aws": multi-node AWS IPI cluster built by openshift-aws-harness
# (bastion + MachineSet GPU pool). Selected with HARNESS_PROFILE=aws.
HARNESS_EXEC="${HARNESS_EXEC:-auto}"
# Bastion of the current openshift-aws-harness cluster (harness/state/<cluster>.env there).
# Empty: HARNESS_EXEC=auto runs locally when `oc whoami` works.
CLUSTER_NAME="${CLUSTER_NAME:-myocp}"
BASTION_IP="${BASTION_IP:-}"
# Pinned to the GPU MachineSet (g5.24xlarge: A10G 24GB x 4 per node); keep in
# sync with manifests/llmd-test-llminferenceservice.json.
GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-g5.24xlarge}"
LLMD_MANIFEST="${LLMD_MANIFEST:-../manifests/llmd-test-llminferenceservice.json}"
GPU_ROLLOUT="${GPU_ROLLOUT:-surge}"
